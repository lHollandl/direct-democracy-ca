# .env.example — copy to .env and fill in. Never commit .env. Every key is required (ARCHITECTURE.md §3).
DATABASE_URL=postgresql+asyncpg://ddcuser:CHANGE_ME@localhost:5432/directdemocracy
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=CHANGE_ME_64_random_hex_chars
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
EMAIL_VERIFY_HOURS=24
PASSWORD_RESET_MINUTES=30
EXPORT_FILE_HOURS=48
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@example.invalid
OLLAMA_BASE_URL=http://HOST_ADDRESS_FROM_SANDBOX:11434
OLLAMA_MODEL=llama3.2
EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=60
SEARCH_PROVIDER=
SEARCH_API_KEY=
SEARCH_BASE_URL=
OFFICIALS_TEST_EMAIL=you@example.com
BUILD_LABEL=demo-01
CORS_ORIGINS=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000
RATE_LIMIT_WRITE_PER_MINUTE=30
LOG_LEVEL=INFO
# Docker Compose only (infra/docker-compose.yml, --env-file .env).
# POSTGRES_USER/PASSWORD/DB must match the credentials inside DATABASE_URL.
POSTGRES_USER=ddcuser
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=directdemocracy
POSTGRES_PORT=5432
REDIS_PORT=6379
